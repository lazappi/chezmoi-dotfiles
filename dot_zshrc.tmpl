# Load plugins using antidote
source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
antidote load

autoload -Uz compinit
compinit -i

# Initalise
## thefuck
eval $(thefuck --alias f)
## zoxide
eval "$(zoxide init zsh)"

# Aliases
## Utils
alias cat='bat --paging=never'
alias less=bat
alias ls=eza
alias ll='eza -l --header --git --time-style=long-iso'
alias tree='eza --tree'
alias grep='grep --color=auto'
## Git
alias gs='git status'
## thefuck
eval $(thefuck --alias fix)
## Starship
eval "$(starship init zsh)"

## Local binaries
export PATH="$HOME/.local/bin:$PATH"
## direnv
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi

{{- $miniforge := joinPath .chezmoi.homeDir "miniforge3" }}
{{- if stat $miniforge }}

## conda / mamba
eval "$({{ $miniforge }}/bin/conda shell.zsh hook)"
export MAMBA_ROOT_PREFIX='{{ $miniforge }}'
eval "$({{ $miniforge }}/bin/mamba shell hook --shell zsh)"
{{- end }}

# Put additional machine-specific content here
source ~/.zshrc_local
