        "color": "blue",
        "bold": true,
        "rawValue": true,
        "commandPath": "d=$(jq -r \".workspace.current_dir // .cwd\"); top=$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null) && echo \"📦 $(basename \"$top\")${d#$top}\" || echo \"📁 $(echo \"$d\" | sed \"s|^$HOME|~|\")\"",
