[user]
  name = Luke Zappia
  email = {{ get . "git_email" | default "lazappi@users.noreply.github.com" }}
{{- $signingKey := joinPath .chezmoi.homeDir ".ssh" "id_ed25519.pub" }}
{{- if stat $signingKey }}
  signingkey = {{ $signingKey }}
{{- end }}

[core]
  autocrlf = input
  compression = 9
  excludesfile = ~/.gitignore_global
  filemode = false
  editor = vim
  whitespace = fix,blank-at-eol,space-before-tab,blank-at-eof,cr-at-eol,tab-in-indent
  pager = diff-so-fancy | less --tabs=4 -RF

[apply]
  whitespace = fix

[alias]
  # Complex aliases from http://michaelwales.com/articles/make-gitconfig-work-for-you/

  # Show all aliases
  aliases = !git config --list | grep 'alias\\.' | sed 's/alias\\.\\([^=]*\\)=\\(.*\\)/\\1\\ \t => \\2/' | sort
  # Amend commit
  amend = !git log -n 1 --pretty=tformat:%s%n%n%b | git commit -F - --amend
  # Unstage changes
  unstage = reset HEAD --
  # Pretty log with tree
  graph = !git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

  # Stacked branches from https://andrewlock.net/pushing-a-whole-stack-of-branches-with-a-single-git-command/
  # Replaced by gh stack

  # Get the default branch
  # default-branch = "!git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'"
  # Get the merge base commit with the default branch on origin
  # merge-base-origin ="!f() { git merge-base ${1-HEAD} origin/$(git default-branch); };f "
  # Show the current branch stack
  # stack = "!f() { \
  #  BRANCH=${1-HEAD}; \
  #  MERGE_BASE=$(git merge-base-origin $BRANCH); \
  #   git log --decorate-refs=refs/heads --simplify-by-decoration --pretty=format:\"%(decorate:prefix=,suffix=,tag=,separator=%n)\" $MERGE_BASE..$BRANCH; \
  # };f "
  # Push the current branch stack. Give a branch name to push up to that branch.
  # push-stack = "!f() { \
  #   BRANCH=${1-HEAD}; \
  #   git stack $BRANCH | xargs -I {} git push --force-with-lease origin {}; \
  # };f "

  # My aliases
  ls = !git log --graph --date=relative --abbrev-commit -n 10 --pretty=format:'%C(yellow)%h%Creset -%Cred%d%Creset %s %C(bold blue)<%an>%Creset %Cgreen(%cr)%Creset'
  ll = !git log --graph --abbrev-commit --all --format=format:'%C(yellow)%h%C(reset) - %C(bold cyan)%aD%C(reset) %Cgreen(%ar)%Creset%Cred%d%Creset%n''%C(white)%s%C(reset) %C(bold blue)<%an>%C(reset)'

[color]
  ui = true

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = 11
  frag = magenta bold
  func = 146 bold
  commit = yellow bold
  old = red bold
  new = green bold
  whitespace = red reverse

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22

[color "status"]
  added = yellow
  changed = green
  untracked = red

[init]
  defaultBranch = main

[help]
  autocorrect = 10

[interactive]
  diffFilter = diff-so-fancy --patch

[push]
  default = simple

[merge]
  log = true
  ff = false
  tool = vimdiff

[rebase]
  updateRefs = true

[rerere]
  enabled = 1
{{- if stat $signingKey }}

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgsign = true
{{- $allowedSigners := joinPath .chezmoi.homeDir ".ssh" "allowed_signers" }}
{{- if stat $allowedSigners }}

[gpg "ssh"]
  allowedSignersFile = {{ $allowedSigners }}
{{- end }}
{{- end }}
{{- with lookPath "gh" }}

[credential "https://github.com"]
  helper =
  helper = !{{ . }} auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !{{ . }} auth git-credential
{{- end }}
